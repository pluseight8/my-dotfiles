# DriftWM config (End-4 inspired minimal neon)
set $mod SUPER
set $terminal foot
set $menu "wofi --show drun"

# Startup apps
exec waybar
exec swaync
exec swww-daemon

# Inputs and appearance
input * xkb_layout us,ru
input * xkb_options grp:alt_shift_toggle
cursor_theme "Bibata-Modern-Classic" 24
focus_follows_mouse yes

# Keybinds
bind $mod+Return exec $terminal
bind $mod+D exec $menu
bind $mod+Q close
bind $mod+Shift+E exit
bind $mod+F fullscreen toggle
bind $mod+V split vertical
bind $mod+B split horizontal
bind $mod+Space floating toggle

# Workspaces
bind $mod+1 workspace 1
bind $mod+2 workspace 2
bind $mod+3 workspace 3
bind $mod+4 workspace 4
bind $mod+5 workspace 5
bind $mod+6 workspace 6
bind $mod+7 workspace 7
bind $mod+8 workspace 8
bind $mod+9 workspace 9

bind $mod+Shift+1 move_to_workspace 1
bind $mod+Shift+2 move_to_workspace 2
bind $mod+Shift+3 move_to_workspace 3
bind $mod+Shift+4 move_to_workspace 4
bind $mod+Shift+5 move_to_workspace 5
bind $mod+Shift+6 move_to_workspace 6
bind $mod+Shift+7 move_to_workspace 7
bind $mod+Shift+8 move_to_workspace 8
bind $mod+Shift+9 move_to_workspace 9

# End-4 style colors
border_width 2
gaps 8
color_active_border #8be9fd
color_inactive_border #313244
color_background #11111b

# Screenshot
bind Print exec grim -g "$(slurp)" ~/Pictures/Screenshots/$(date +%s).png
