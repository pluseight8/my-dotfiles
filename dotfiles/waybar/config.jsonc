{
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 8,
  "modules-left": ["custom/launcher", "driftwm/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "cpu", "memory", "battery", "tray"],

  "custom/launcher": {
    "format": "   ",
    "on-click": "wofi --show drun"
  },

  "clock": {
    "format": "  {:%a %d %b  %H:%M}"
  },

  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "  mute"
  },

  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀  wired",
    "format-disconnected": "󰌙  down"
  },

  "cpu": {
    "format": "  {usage}%"
  },

  "memory": {
    "format": "  {}%"
  },

  "battery": {
    "format": "  {capacity}%",
    "format-charging": "  {capacity}%"
  }
}
