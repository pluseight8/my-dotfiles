[Unit]
Description=Trigger HONOR eDP modeset once Omarchy's Wayland session is ready
After=dbus.socket wayland-session-waitenv.service
Requires=dbus.socket
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/honor/dsc-modeset-user.sh

[Install]
WantedBy=graphical-session.target
