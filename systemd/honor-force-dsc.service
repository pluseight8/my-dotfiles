[Unit]
Description=Arm DSC on HONOR ZQC-P M1230 internal eDP panel before user sessions
After=systemd-modules-load.service local-fs.target
Before=systemd-user-sessions.service graphical.target
ConditionPathExists=/sys/class/dmi/id/board_version

[Service]
Type=oneshot
ExecStart=/usr/local/lib/honor/force-dsc.sh
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
